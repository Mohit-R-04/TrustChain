# Supabase Database Configuration
# Get these from your Supabase project: Settings -> Database

SUPABASE_DB_HOST=db.<your-project-ref>.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your-database-password>
SUPABASE_DB_PORT=5432
SUPABASE_DB_SSLMODE=require

# Alternative: provide a full JDBC URL directly
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<your-database-password>

# Clerk
CLERK_SECRET_KEY=<your-clerk-secret-key>
CLERK_WEBHOOK_SECRET=<your-clerk-webhook-secret>

# Email (SMTP) Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-sender-email>
MAIL_PASSWORD=<your-app-password-or-smtp-password>
MAIL_SMTP_AUTH=true
MAIL_AUTH_MECHANISMS=LOGIN
MAIL_SSL_TRUST=smtp.gmail.com
MAIL_DEBUG=false

# OTP Delivery Configuration
OTP_DELIVERY_MODE=email
OTP_DELIVERY_FALLBACK_TO_LOG=false

# OTP Settings
OTP_VALIDITY_SECONDS=300
OTP_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_TOKEN_VALIDITY_SECONDS=600

# CORS
# Comma-separated origin patterns. For production, add your frontend domain.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000

# IPFS (Web3.Storage)
# Set either IPFS_WEB3STORAGE_TOKEN or WEB3_STORAGE_TOKEN
IPFS_WEB3STORAGE_TOKEN=<your-web3storage-token>
IPFS_PROVIDER=web3storage
# If you use a local IPFS node (Kubo/IPFS Desktop), set:
# IPFS_PROVIDER=kubo
# IPFS_KUBO_API_BASE_URL=http://localhost:5001
# If you use Pinata, set:
# IPFS_PROVIDER=pinata
# PINATA_JWT=<your-pinata-jwt>

# Blockchain (optional in dev; required if you enable on-chain writes)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_DEMO_MODE=true
TRUSTCHAIN_ESCROW_PRIVATE_KEY=<your-private-key>
TRUSTCHAIN_ESCROW_CONTRACT_ADDRESS=<your-contract-address>
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
