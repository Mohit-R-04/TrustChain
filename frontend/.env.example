# TrustChain Frontend Environment Variables

# Clerk Authentication
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_your_clerk_publishable_key

# Backend API URL
# Local example:
# REACT_APP_API_URL=http://localhost:8080
# Hosted example:
# REACT_APP_API_URL=https://api.yourdomain.com
REACT_APP_API_URL=http://localhost:8080

# IPFS Gateway base URL (path-style gateway recommended)
REACT_APP_IPFS_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs/
